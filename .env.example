# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=sanjeevani
POSTGRES_PASSWORD=sanjeevani_dev_pass
POSTGRES_DB=sanjeevani
DATABASE_URL=postgresql://sanjeevani:sanjeevani_dev_pass@postgres:5432/sanjeevani

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Auth
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d
OTP_EXPIRY_SECONDS=300

# Server
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173,http://localhost:8081

# AI Service
AI_SERVICE_URL=http://ai-service:8000

# Storage (MinIO for local dev)
S3_ENDPOINT=http://minio:9000
S3_BUCKET=sanjeevani-files
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# SMS (mock in dev)
SMS_PROVIDER=mock
SMS_API_KEY=

# LiveKit (video)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
